# TaaskMaaster Environment Configuration
# Copy this file to .env and customize the values for your setup

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
# Default: sqlite in DATA_DIR (./data/task4ce.db)
# DATABASE_URL=
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/taaskmaaster

# Secrets are generated on first boot into DATA_DIR/secrets.json.
# Optionally override: SECRET_KEY, JWT_SECRET_KEY, INTERNAL_TOKEN

# Service Ports
BACKEND_PORT=127.0.0.1:8000
FRONTEND_PORT=0.0.0.0:3000

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TaaskMaaster

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.95:3000
# Comma-separated list of trusted hosts
TRUSTED_HOSTS=localhost,127.0.0.1,192.168.1.95,taaskmaaster-backend

# Rate Limiting
DISABLE_RATE_LIMITING=false
DISABLE_LOGIN_RATE_LIMIT=true

# Node.js Environment
NODE_ENV=development

# PostgreSQL (optional, for production)
# POSTGRES_PASSWORD=taaskmaaster123