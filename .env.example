# TaaskMaaster Environment Configuration
# Copy this file to .env and customize the values for your setup

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./taaskmaaster.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/taaskmaaster

# Security Keys (CHANGE IN PRODUCTION!)
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# Service Ports
BACKEND_PORT=127.0.0.1:8000
FRONTEND_PORT=0.0.0.0:3000

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TaaskMaaster

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.95:3000
# Comma-separated list of trusted hosts
TRUSTED_HOSTS=localhost,127.0.0.1,192.168.1.95,taaskmaaster-backend

# Redis
REDIS_URL=redis://redis:6379

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=taaskmaaster-media
MINIO_SECURE=false

# Rate Limiting
DISABLE_RATE_LIMITING=false
DISABLE_LOGIN_RATE_LIMIT=true

# Node.js Environment
NODE_ENV=development

# PostgreSQL (optional, for production)
# POSTGRES_PASSWORD=taaskmaaster123